# Template de variáveis de ambiente da FASE_4. Copie para ".env" (dentro de FASE_4/).
# O ".env" é ignorado pelo git. Para preencher as chaves Azure automaticamente:
#   az login  →  .\scripts\azure_setup.ps1   (troca de conta = rodar de novo logado na conta nova)

# ---- Azure ----
# live    = só Azure (falha sem chave)        auto   = cache → Azure → fallback local (padrão)
# replay  = só respostas já gravadas no cache  offline = só fallback local, sem rede
AZURE_MODE=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# idioma das consultas do PriMock57 (inglês britânico); para consultas em português: pt-BR
AZURE_SPEECH_LANGUAGE=en-GB
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_TEXT_LANGUAGE=en
AZURE_CACHE_DIR=data/azure_cache

# ---- Dados ----
# Dados brutos (não versionados). Pode apontar para outro disco.
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
RESULTS_DIR=results

# ---- Vídeo ----
# yolo | openpose
POSE_BACKEND=yolo
YOLO_POSE_WEIGHTS=yolov8n-pose.pt
YOLO_DET_WEIGHTS=yolov8n.pt
VIDEO_FPS=10

# ---- Alertas ----
# Incoming webhook do Teams/Slack (opcional). Alertas ≥ urgente são enviados para cá.
ALERT_WEBHOOK_URL=
EVENTS_DIR=logs/events
AUDIT_DIR=logs/audit

# Template de variaveis de ambiente da FASE_3.
# Copie para ".env" (dentro de FASE_3/) e preencha. O ".env" e ignorado pelo git.

# ---- Modelo ----
# Modelo base usado no fine-tuning e no runtime do assistente.
BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# Caminho do adapter LoRA treinado (gerado pelo pipeline de fine-tuning).
ADAPTER_PATH=finetune/outputs/adapter
# Forca o modo fallback deterministico (sem carregar pesos). true|false
FORCE_FALLBACK=false
# Dispositivo: auto | cpu | cuda
DEVICE=auto

# ---- RAG ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTORSTORE_PATH=data/vectorstore

# ---- Base estruturada ----
HOSPITAL_DB=data/hospital.db

# ---- Observabilidade ----
LOG_LEVEL=INFO
AUDIT_LOG_DIR=logs/audit

# ---- Token HuggingFace (necessario apenas para modelos gated, ex.: Llama) ----
HF_TOKEN=
